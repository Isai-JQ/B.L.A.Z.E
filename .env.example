# Copy to `.env` and fill in. `.env` is gitignored and never committed; this file only
# lists the variable names (T2). Where each value comes from is noted per line.

# Supabase → Project Settings → Database. Transaction pooler (port 6543): the app's
# runtime queries (lib/db.ts, the gateway).
DATABASE_URL=

# Same page, session pooler (port 5432). Only for `pnpm db:push` (drizzle-kit hangs
# against the transaction pooler) and the integration tests.
DIRECT_URL=

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, same page. Server-only: lib/supabaseAdmin.ts (API routes) and the
# gateway, which reads job files from Storage with it. Never imported in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where the dashboard reaches the MQTT gateway (`pnpm gateway`, default port 9001).
NEXT_PUBLIC_WS_PROXY_URL=ws://localhost:9001

# Shared bearer token between the Next.js API routes and the gateway's GET /printers and
# POST /control. Any long random string; the same value must be set on both sides.
GATEWAY_SHARED_SECRET=
